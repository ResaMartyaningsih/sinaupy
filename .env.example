# ==============================================================================
# SINAUPY ENVIRONMENT VARIABLES CONFIGURATION (SUPABASE)
# ==============================================================================
# Salin file ini menjadi `.env` atau `.env.local` di komputer lokal,
# dan masukkan juga variabel ini pada Vercel Dashboard:
# Project Settings -> Environment Variables.
#
# Catatan Keamanan:
# - HANYA gunakan Anon Public Key (bukan Service Role Key).
# - Row Level Security (RLS) di Supabase akan melindungi data siswa secara otomatis.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

